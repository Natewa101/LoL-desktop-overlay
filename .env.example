# Copy this file to `.env` in the repository root and fill in your values.
# NEVER commit your real `.env` file.

# ---------------------------------------------------------------------------
# Backend (FastAPI) - read by lol-backend/config.py via python-dotenv
# ---------------------------------------------------------------------------
# Riot Games API key from https://developer.riotgames.com
# Only required for the /api/live-history endpoint. The live overlay and draft
# assistant use the local League client APIs and work without it.
RIOT_API_KEY=RGAPI-262cf968-cd0e-4c87-9b02-be18c5d517aa

# Riot routing values (platform e.g. euw1, na1, kr | region e.g. europe, americas, asia)
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Address the backend binds to
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (Vite / React) - baked in at build time, must be prefixed VITE_
# ---------------------------------------------------------------------------
# Must match BACKEND_HOST / BACKEND_PORT above
VITE_API_BASE_URL=http://127.0.0.1:8000

# Riot Data Dragon patch used for champion/item icons
VITE_DDRAGON_VERSION=15.1.1

# ---------------------------------------------------------------------------
# Electron (development only)
# ---------------------------------------------------------------------------
# URL of the Vite dev server loaded by `npm run electron:dev`.
# Read from the shell environment (not from this file); listed for reference.
ELECTRON_START_URL=http://localhost:5173
